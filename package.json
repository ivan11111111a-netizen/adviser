{
  "name": "adviser",
  "displayName": "Adviser",
  "description": "%description%",
  "version": "0.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivan11111111a-netizen/adviser"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E3A8A",
    "theme": "dark"
  },
  "categories": [
    "Education",
    "AI",
    "Linters"
  ],
  "keywords": [
    "mentor",
    "learning",
    "beginner",
    "code review",
    "hints",
    "наставник",
    "обучение"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "adviser.reviewFunction",
        "title": "%command.reviewFunction%",
        "category": "Adviser"
      },
      {
        "command": "adviser.setApiKey",
        "title": "%command.setApiKey%",
        "category": "Adviser"
      },
      {
        "command": "adviser.openWalkthrough",
        "title": "%command.openWalkthrough%",
        "category": "Adviser"
      },
      {
        "command": "adviser.setupOpenRouter",
        "title": "%command.setupOpenRouter%",
        "category": "Adviser"
      },
      {
        "command": "adviser.setupCopilot",
        "title": "%command.setupCopilot%",
        "category": "Adviser"
      },
      {
        "command": "adviser.setupOllama",
        "title": "%command.setupOllama%",
        "category": "Adviser"
      },
      {
        "command": "adviser.setupOwnKey",
        "title": "%command.setupOwnKey%",
        "category": "Adviser"
      },
      {
        "command": "adviser.chooseLevel",
        "title": "%command.chooseLevel%",
        "category": "Adviser"
      },
      {
        "command": "adviser.tryReview",
        "title": "%command.tryReview%",
        "category": "Adviser"
      },
      {
        "command": "adviser.revokeConsent",
        "title": "%command.revokeConsent%",
        "category": "Adviser"
      },
      {
        "command": "adviser.showMenu",
        "title": "%command.showMenu%",
        "category": "Adviser"
      },
      {
        "command": "adviser.exportJournal",
        "title": "%command.exportJournal%",
        "category": "Adviser"
      },
      {
        "command": "adviser.clearJournal",
        "title": "%command.clearJournal%",
        "category": "Adviser"
      },
      {
        "command": "adviser.weeklyReport",
        "title": "%command.weeklyReport%",
        "category": "Adviser",
        "icon": "$(graph)"
      },
      {
        "command": "adviser.exercise",
        "title": "%command.exercise%",
        "category": "Adviser",
        "icon": "$(mortar-board)"
      },
      {
        "command": "adviser.understandChanges",
        "title": "%command.understandChanges%",
        "category": "Adviser"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "adviser.reviewFunction",
          "group": "adviser"
        }
      ],
      "view/title": [
        {
          "command": "adviser.exercise",
          "when": "view == adviser.journal",
          "group": "navigation@1"
        },
        {
          "command": "adviser.weeklyReport",
          "when": "view == adviser.journal",
          "group": "navigation@2"
        },
        {
          "command": "adviser.exportJournal",
          "when": "view == adviser.journal",
          "group": "journal@1"
        },
        {
          "command": "adviser.clearJournal",
          "when": "view == adviser.journal",
          "group": "journal@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "adviser",
          "title": "Adviser",
          "icon": "media/adviser.svg"
        }
      ]
    },
    "views": {
      "adviser": [
        {
          "id": "adviser.journal",
          "name": "%view.journal%"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.adviser/config.json",
        "url": "./schemas/adviser-config.schema.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "adviser.start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "model",
            "title": "%walkthrough.model.title%",
            "description": "%walkthrough.model.description%",
            "media": {
              "markdown": "%walkthrough.model.media%"
            },
            "completionEvents": [
              "onSettingChanged:adviser.model"
            ]
          },
          {
            "id": "level",
            "title": "%walkthrough.level.title%",
            "description": "%walkthrough.level.description%",
            "media": {
              "markdown": "%walkthrough.level.media%"
            },
            "completionEvents": [
              "onCommand:adviser.chooseLevel"
            ]
          },
          {
            "id": "try",
            "title": "%walkthrough.try.title%",
            "description": "%walkthrough.try.description%",
            "media": {
              "markdown": "%walkthrough.try.media%"
            },
            "completionEvents": [
              "onCommand:adviser.tryReview"
            ]
          },
          {
            "id": "journal",
            "title": "%walkthrough.journal.title%",
            "description": "%walkthrough.journal.description%",
            "media": {
              "markdown": "%walkthrough.journal.media%"
            },
            "completionEvents": [
              "onView:adviser.journal"
            ]
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "adviser.journal",
        "contents": "%view.journal.welcome%"
      }
    ],
    "configuration": {
      "title": "Adviser",
      "properties": {
        "adviser.mode": {
          "type": "string",
          "enum": [
            "mentor",
            "reviewer",
            "manual"
          ],
          "enumDescriptions": [
            "%config.mode.enum.mentor%",
            "%config.mode.enum.reviewer%",
            "%config.mode.enum.manual%"
          ],
          "default": "mentor",
          "description": "%config.mode.description%"
        },
        "adviser.level": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "enumDescriptions": [
            "%config.level.enum.beginner%",
            "%config.level.enum.intermediate%",
            "%config.level.enum.advanced%"
          ],
          "default": "beginner",
          "description": "%config.level.description%"
        },
        "adviser.language": {
          "type": "string",
          "enum": [
            "auto",
            "ru",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.enum.auto%",
            "%config.language.enum.ru%",
            "%config.language.enum.en%"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "adviser.solutionDelay": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "off"
          ],
          "enumDescriptions": [
            "%config.solutionDelay.enum.auto%",
            "%config.solutionDelay.enum.always%",
            "%config.solutionDelay.enum.off%"
          ],
          "default": "auto",
          "description": "%config.solutionDelay.description%"
        },
        "adviser.hiddenPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.hiddenPatterns.markdownDescription%"
        },
        "adviser.budget.inputPricePerMillion": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "%config.budget.inputPricePerMillion.markdownDescription%"
        },
        "adviser.budget.outputPricePerMillion": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "%config.budget.outputPricePerMillion.markdownDescription%"
        },
        "adviser.budget.dailyLimitUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "%config.budget.dailyLimitUsd.markdownDescription%"
        },
        "adviser.budget.monthlyLimitUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "%config.budget.monthlyLimitUsd.markdownDescription%"
        },
        "adviser.budget.fallbackModel": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.budget.fallbackModel.markdownDescription%"
        },
        "adviser.budget.fallbackBaseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "scope": "machine",
          "markdownDescription": "%config.budget.fallbackBaseUrl.markdownDescription%"
        },
        "adviser.provider": {
          "type": "string",
          "enum": [
            "openai-compatible",
            "copilot",
            "claude-code",
            "mock"
          ],
          "enumDescriptions": [
            "%config.provider.enum.openai-compatible%",
            "%config.provider.enum.copilot%",
            "%config.provider.enum.claude-code%",
            "%config.provider.enum.mock%"
          ],
          "default": "openai-compatible",
          "scope": "machine",
          "description": "%config.provider.description%"
        },
        "adviser.baseUrl": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "scope": "machine",
          "markdownDescription": "%config.baseUrl.markdownDescription%"
        },
        "adviser.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.model.markdownDescription%"
        },
        "adviser.dev.prompt": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.dev.prompt.markdownDescription%"
        },
        "adviser.dev.claudePath": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "description": "%config.dev.claudePath.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "vsce package --no-dependencies",
    "compile-tests": "tsc -p test/integration",
    "watch-tests": "tsc -p test/integration -w",
    "check-types": "tsc -p . && tsc -p test/unit && tsc -p test/integration --noEmit && tsc -p evals",
    "lint": "eslint src test evals --max-warnings 0",
    "eval": "esbuild evals/run.ts --bundle --platform=node --format=esm --packages=external --outfile=out/evals/run.mjs --log-level=warning && node out/evals/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "pretest:integration": "npm run compile-tests && node esbuild.js",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.101.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.68",
    "ai": "^7.0.139",
    "zod": "^4.6.7"
  }
}
