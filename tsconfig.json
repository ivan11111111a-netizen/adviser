{
  // src собирает esbuild, поэтому типы проверяем по правилам бандлера: ESM-only пакеты (ai, vitest) так импортируются.
  // Интеграционные тесты tsc компилирует в CommonJS для mocha — у них свой test/integration/tsconfig.json.
  "compilerOptions": {
    "module": "Preserve",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
